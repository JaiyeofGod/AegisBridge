# AegisBridge local development placeholders
# Copy to `.env` and replace values. Never commit `.env` or real secrets.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=local
APP_NAME=aegisbridge
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phase 2 authentication — replace with a long random value locally
SESSION_SECRET=change-me-generate-a-long-random-secret

# -----------------------------------------------------------------------------
# PostgreSQL (Docker Compose)
# -----------------------------------------------------------------------------
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis
DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis

# -----------------------------------------------------------------------------
# Redis / Valkey (Docker Compose)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Object storage — SeaweedFS locally (S3 API) / Cloudflare R2 in hosted envs
# Application code must use an S3-compatible client abstraction (not SeaweedFS APIs).
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:8333
AWS_ACCESS_KEY_ID=aegislocal
AWS_SECRET_ACCESS_KEY=aegislocalchangeme
S3_BUCKET=aegis-dev-evidence
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Later phases only — leave unset locally until needed
# -----------------------------------------------------------------------------
# NVD_API_KEY=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# WAZUH_API_URL=
# WAZUH_API_USER=
# WAZUH_API_PASSWORD=
# LAB_BRIDGE_TOKEN=
