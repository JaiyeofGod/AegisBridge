# AegisBridge local development placeholders
# Copy to `.env` and replace values. Never commit `.env` or real secrets.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=local
APP_NAME=aegisbridge
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phase 2 authentication — replace with a long random value locally
SESSION_SECRET=change-me-generate-a-long-random-secret
SESSION_COOKIE_NAME=aegis_session
SESSION_COOKIE_PATH=/
SESSION_COOKIE_SAMESITE=lax
# Leave unset to auto-enable Secure outside local/dev/test
# SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=28800
# Required for local/development seed of USR-0001. No default.
# Re-run `python -m app.db.seed` after changing it. Ignored when APP_ENV=production.
# AEGIS_DEV_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# PostgreSQL (Docker Compose)
# -----------------------------------------------------------------------------
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis
DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis
# Pytest only. Must name a different database than DATABASE_URL.
# Ignored when APP_ENV is local, development, or production.
# Create it with: python -m app.db.test_db ensure
TEST_DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis_test

# -----------------------------------------------------------------------------
# Redis / Valkey (Docker Compose)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Celery broker. When unset, the worker uses REDIS_URL. Valkey speaks this protocol.
# Do not set CELERY_RESULT_BACKEND. Sync status is stored in PostgreSQL.
CELERY_BROKER_URL=redis://localhost:6379/0
# Daily tracked-CVE intelligence sync. Hour is UTC. The first NVD call in a run is immediate.
# VULNERABILITY_SYNC_ENABLED=true
# VULNERABILITY_SYNC_HOUR_UTC=6
# Public NVD limit is about five requests per 30 seconds. Set 0 when a key and a small set make that unnecessary.
# VULNERABILITY_SYNC_NVD_PAUSE_SECONDS=6
# VULNERABILITY_SYNC_LOCK_TTL_SECONDS=1800

# -----------------------------------------------------------------------------
# Object storage — SeaweedFS locally (S3 API) / Cloudflare R2 in hosted envs
# Application code must use an S3-compatible client abstraction (not SeaweedFS APIs).
# Objects are private. Do not commit real credentials.
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:8333
AWS_ACCESS_KEY_ID=aegislocal
AWS_SECRET_ACCESS_KEY=aegislocalchangeme
S3_BUCKET=aegis-dev-evidence
S3_REGION=us-east-1
OBJECT_STORAGE_PROVIDER=seaweedfs
# Development default 25 MiB. Raise carefully for hosted environments.
EVIDENCE_MAX_UPLOAD_BYTES=26214400

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Optional vulnerability intelligence. Official URLs are the defaults.
# Leave NVD_API_KEY unset to use the unauthenticated NVD CVE API.
# -----------------------------------------------------------------------------
# NVD_API_KEY=
# NVD_CVE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
# CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# FIRST_EPSS_URL=https://api.first.org/data/v1/epss
# VULNERABILITY_INTELLIGENCE_TIMEOUT_SECONDS=10

# Pinned MITRE ATT&CK Enterprise STIX 2.1. Do not point this at an unversioned latest bundle.
# ATTACK_ENTERPRISE_VERSION=20.0
# ATTACK_ENTERPRISE_STIX_URL=https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack-20.0.json
# ATTACK_STIX_TIMEOUT_SECONDS=120
# ATTACK_STIX_MAX_BYTES=80000000

# abuse.ch community key from https://auth.abuse.ch/. Header only. Never put it in a URL.
# Without it, ThreatFox and URLhaus ingestion fails closed.
# ABUSECH_AUTH_KEY=
# THREATFOX_API_URL=https://threatfox-api.abuse.ch/api/v1/
# THREATFOX_DAYS=1
# URLHAUS_RECENT_URL=https://urlhaus-api.abuse.ch/v1/urls/recent/
# THREAT_INTEL_IOC_LIMIT=500
# THREAT_INTEL_SYNC_ENABLED=true
# THREAT_INTEL_SYNC_LOCK_TTL_SECONDS=1800
# THREAT_INTEL_HTTP_TIMEOUT_SECONDS=30
# THREAT_INTEL_MAX_BYTES=20000000

# -----------------------------------------------------------------------------
# Later phases only — leave unset locally until needed
# -----------------------------------------------------------------------------
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# LAB_BRIDGE_TOKEN=

# Wazuh indexer alert polling. Disabled until a deployment sets the indexer URL.
# This is the OpenSearch-compatible indexer, not the manager API on port 55000.
# Leave TLS verification on. WAZUH_VERIFY_TLS=false is a local development opt-in
# and is ignored when APP_ENV=production. Never put the password in the URL.
# WAZUH_ENABLED=false
# WAZUH_INDEXER_URL=https://wazuh-indexer.example:9200
# WAZUH_USERNAME=
# WAZUH_PASSWORD=
# WAZUH_VERIFY_TLS=true
# WAZUH_ALERT_INDEX=wazuh-alerts*
# WAZUH_LOOKBACK_MINUTES=15
# WAZUH_ALERT_LIMIT=500
