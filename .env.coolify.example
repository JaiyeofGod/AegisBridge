# Coolify production environment template.
# Leave every value empty in git. Enter the operator values in Coolify, not in this file.
# Do not paste a development .env over these names.

# ---------------------------------------------------------------------------
# BUILD-TIME AND RUNTIME
# Compose interpolates these before docker compose build because they use
# required substitutions in the backend environment. They are not image build
# arguments. Set the Coolify scope to build and runtime. Use the real https
# domains from Coolify. Do not type a Google Cloud IP or a development URL.
# ---------------------------------------------------------------------------
#
# PUBLIC_API_URL
#   Source: operator. Public API origin, including https://.
# TRUSTED_HOSTS
#   Source: operator. API hostname only, no scheme.
# CORS_ORIGINS
#   Source: operator. Browser origin, including https://. Not the API origin.

PUBLIC_API_URL=
TRUSTED_HOSTS=
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# BUILD-TIME ONLY
# This is the only value the frontend Dockerfile receives. Changing the API
# domain requires a web image rebuild. Do not put backend secrets here.
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# PRIVATE / RUNTIME
# Generated by Coolify from the Compose file. Do not replace them with
# development passwords or paste them into the frontend build.
# ---------------------------------------------------------------------------
#
# SERVICE_USER_POSTGRES
#   Source: Coolify-generated database user.
# SERVICE_PASSWORD_64_POSTGRES
#   Source: Coolify-generated database password. It is URL-safe.
# SERVICE_PASSWORD_64_SESSION
#   Source: Coolify-generated SESSION_SECRET. Leave it in Coolify.
# POSTGRES_DB
#   Source: operator input. Runtime only. Database name, not a password.
#   Suggested value: aegisbridge

POSTGRES_DB=

# Cloudflare R2 private bucket. Runtime only. The API, worker, Beat, and
# migration containers receive these when they start. The image build does not.
# S3_ENDPOINT_URL example shape: https://<account-id>.r2.cloudflarestorage.com
# S3_REGION is fixed to auto in compose.coolify.yaml.
# OBJECT_STORAGE_PROVIDER is fixed to r2 in compose.coolify.yaml.

S3_ENDPOINT_URL=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL, DISABLED ON FIRST LAUNCH
# Do not set these until the corresponding feature is enabled.
# Threat intelligence sync and Wazuh are fixed off in compose.coolify.yaml.
# Vulnerability intelligence stays enabled and does not need NVD_API_KEY.
# ---------------------------------------------------------------------------
#
# NVD_API_KEY=
# ABUSECH_AUTH_KEY=
# HF_TOKEN=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
